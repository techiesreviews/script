{
  // Static assets, plus the Worker for MCP (/mcp), the live relay (/api/relay) and rooms for working together (/api/room).
  // Cloudflare free plan: Workers, static assets and SQLite-backed Durable Objects (the relay, and rooms since step D).
  "name": "script-editor",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  // Lex approved script.techies.tools on 2026-10-28. The workers.dev address keeps working too.
  "routes": [{ "pattern": "script.techies.tools", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["Room"] }
  ]
}
